-- ============================================================
-- FUZZY SEARCH
-- ============================================================
local function similarity(query, target)
	query = string.lower(query)
	target = string.lower(target)
	if query == "" then return 1 end
	if target == query then return 2 end
	if string.sub(target, 1, #query) == query then return 1.5 end
	if string.find(target, query, 1, true) then return 1 end
	local len1, len2 = #query, #target
	if len1 == 0 then return 1 end
	if len2 == 0 then return 0 end
	local matrix = {}
	for i = 0, len1 do matrix[i] = { [0] = i } end
	for j = 0, len2 do matrix[0][j] = j end
	for i = 1, len1 do
		for j = 1, len2 do
			local cost = (string.sub(query, i, i) == string.sub(target, j, j)) and 0 or 1
			matrix[i][j] = math.min(
				matrix[i - 1][j] + 1,
				matrix[i][j - 1] + 1,
				matrix[i - 1][j - 1] + cost
			)
		end
	end
	local dist = matrix[len1][len2]
	local maxLen = math.max(len1, len2)
	return 1 - (dist / maxLen)
end

-- Vazio = todos | digitando = só os parecidos (mais parecido no topo)
local function filterCommands(query)
	local scored = {}

	if query == "" then
		for _, cmd in ipairs(COMMANDS) do
			table.insert(scored, { cmd = cmd, score = 0 })
		end
		return scored
	end

	local MIN_SCORE = 0.35
	for _, cmd in ipairs(COMMANDS) do
		local score = similarity(query, cmd.name)
		if score >= MIN_SCORE then
			table.insert(scored, { cmd = cmd, score = score })
		end
	end

	table.sort(scored, function(a, b)
		if a.score == b.score then return a.cmd.name < b.cmd.name end
		return a.score > b.score
	end)

	return scored
end

local function executeCommand(name, value)
	for _, cmd in ipairs(COMMANDS) do
		if cmd.name == name then
			if type(cmd.run) == "function" then
				local ok, err = pcall(cmd.run, value)
				return ok, err
			end
			return false, "Comando sem função"
		end
	end
	return false, "Comando desconhecido"
end

