-- ============================================================
-- EXECUTAR COMANDO POR PREFIXO NO CHAT (; : /)
-- ============================================================
local function ExecuteCommand(msg)
	if type(msg) ~= "string" then return end

	local prefix = msg:sub(1, 1)
	if prefix ~= ";" and prefix ~= ":" and prefix ~= "/" then return end

	local pureText = msg:sub(2)
	local parts = {}
	for w in string.gmatch(pureText, "%S+") do
		table.insert(parts, w)
	end
	if #parts == 0 then return end

	local cmdName = string.lower(parts[1])
	table.remove(parts, 1)
	local value = #parts > 0 and table.concat(parts, " ") or nil

	local found = nil
	for _, cmd in ipairs(COMMANDS) do
		if string.lower(cmd.name) == cmdName then
			found = cmd
			break
		end
	end
	if not found then return end

	local finalValue = nil
	if found.args and value ~= nil then
		finalValue = tonumber(value) or value
	end

	local ok, err = pcall(function()
		if type(found.run) == "function" then
			found.run(finalValue)
		end
	end)
	if not ok then
		warn("[CommandMenu] Erro ao executar '" .. found.name .. "':", err)
	end
end

