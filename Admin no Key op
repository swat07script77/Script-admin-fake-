	run = function(value)
		local arg = tostring(value or "")
		if arg == "" then return end
		local q = string.lower(arg)
		local found = nil
		for _, p in ipairs(game.Players:GetPlayers()) do
			if p ~= player then
				if string.lower(p.Name) == q or string.lower(p.DisplayName) == q
					or string.find(string.lower(p.Name), q, 1, true)
					or string.find(string.lower(p.DisplayName), q, 1, true) then
					found = p
					break
				end
			end
		end
		if not found then return end
		if not (found.Character and found.Character:FindFirstChild("HumanoidRootPart")) then return end

		-- Verifica se você tem alguma tool
		local char = player.Character
		if not char then return end
		local hasTool = false
		if char:FindFirstChildOfClass("Tool") then
			hasTool = true
		else
			local bp = player:FindFirstChildOfClass("Backpack")
			if bp and bp:FindFirstChildOfClass("Tool") then
				hasTool = true
			end
		end
		if not hasTool then
			warn("[Kill] You need to have a tool in your inventory")
			return
		end

		local function getRoot(c)
			if not c then return nil end
			return c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso") or c:FindFirstChild("UpperTorso")
		end

		local function attach(attacker, targetChar)
			local hrp = getRoot(attacker.Character)
			local trp = getRoot(targetChar)
			if not hrp or not trp then return end
			-- Traz pro atacante
			local tool = attacker.Character:FindFirstChildOfClass("Tool")
			if tool then
				pcall(function() tool:Activate() end)
