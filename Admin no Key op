{
	name = "Dash",
	desc = "Dash | walk + jump",
	args = false,
	run = function(value)
		_G.DashActive = true
		_G.DashMultiplier = _G.DashMultiplier or 1
		_G.DashLast = 0
		local cooldown = 0.3
		local function startDash()
			local char = player.Character
			if not char then return end
			local root = char:FindFirstChild("HumanoidRootPart")
			if not root then return end
			if tick() - _G.DashLast < cooldown then return end
			local vel = root.Velocity
			local speed = vel.Magnitude
			if speed < 0.5 then return end
			local dir = vel.Unit
			local force = speed * _G.DashMultiplier * 2
			root.Velocity = Vector3.new(dir.X * force, vel.Y, dir.Z * force)
			_G.DashLast = tick()
		end
		if _G.DashJumpConn then _G.DashJumpConn:Disconnect() end
		if _G.DashTouchConn then _G.DashTouchConn:Disconnect() end
		_G.DashJumpConn = UserInputService.JumpRequest:Connect(function()
			if _G.DashActive then startDash() end
		end)
		_G.DashTouchConn = UserInputService.TouchTap:Connect(function()
			if _G.DashActive then startDash() end
		end)
	end,
