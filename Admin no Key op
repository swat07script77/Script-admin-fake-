{
	name = "Orbit",
	desc = "Orbit | name distance",
	args = true,
	run = function(value)
		local arg = tostring(value or "")
		if arg == "" then return end

		-- Separa: nome (tudo até o último espaço) + distância (número no final)
		local nameArg, distArg = string.match(arg, "^(.-)%s+([%d%.]+)$")
		if not nameArg then
			nameArg = arg
			distArg = "10"
		end
		local distance = tonumber(distArg) or 10
		if distance < 1 then distance = 1 end

		local q = string.lower(nameArg)
		local found = nil
		for _, p in ipairs(game.Players:GetPlayers()) do
			if p ~= player then
				if string.lower(p.Name) == q or string.lower(p.DisplayName) == q
					or string.find(string.lower(p.Name), q, 1, true)
					or string.find(string.lower(p.DisplayName), q, 1, true) then
					found = p
					break
				end
			end
		end
		if not found then return end

		_G.OrbitActive = true
		_G.OrbitTarget = found
		_G.OrbitDistance = distance
		_G.OrbitAngle = 0

		if _G.OrbitConn then _G.OrbitConn:Disconnect() end
		_G.OrbitConn = RunService.Heartbeat:Connect(function(dt)
			if not _G.OrbitActive or not _G.OrbitTarget then return end
			local target = _G.OrbitTarget
			if not target.Character then return end
			local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
			local myChar = player.Character
			local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
			if not targetRoot or not myRoot then return end

			_G.OrbitAngle = _G.OrbitAngle + dt * 2
			local offset = Vector3.new(math.cos(_G.OrbitAngle) * _G.OrbitDistance, 2, math.sin(_G.OrbitAngle) * _G.OrbitDistance)
			myRoot.CFrame = CFrame.new(targetRoot.Position + offset, targetRoot.Position)
		end)
	end,
},
