{
	name = "AntiLag",
	desc = "AntiLag | boost fps",
	args = false,
	run = function(value)
		if _G.AntiLagActive then return end
		_G.AntiLagActive = true
		_G.AntiLagBackup = _G.AntiLagBackup or {parts = {}, decals = {}, light = {}, terrain = {}, post = {}}

		local Terrain = workspace:FindFirstChildWhichIsA("Terrain")
		if Terrain then
			_G.AntiLagBackup.terrain.WaterWaveSize = Terrain.WaterWaveSize
			_G.AntiLagBackup.terrain.WaterWaveSpeed = Terrain.WaterWaveSpeed
			_G.AntiLagBackup.terrain.WaterReflectance = Terrain.WaterReflectance
			_G.AntiLagBackup.terrain.WaterTransparency = Terrain.WaterTransparency
			Terrain.WaterWaveSize = 0
			Terrain.WaterWaveSpeed = 0
			Terrain.WaterReflectance = 0
			Terrain.WaterTransparency = 1
		end

		local Lighting = game:GetService("Lighting")
		_G.AntiLagBackup.light.GlobalShadows = Lighting.GlobalShadows
		_G.AntiLagBackup.light.FogEnd = Lighting.FogEnd
		_G.AntiLagBackup.light.FogStart = Lighting.FogStart
		Lighting.GlobalShadows = false
		Lighting.FogEnd = 9e9
		Lighting.FogStart = 9e9

		for _, v in ipairs(game:GetDescendants()) do
			if v:IsA("BasePart") then
				_G.AntiLagBackup.parts[v] = {CastShadow = v.CastShadow, Material = v.Material, Reflectance = v.Reflectance}
				v.CastShadow = false
				v.Material = Enum.Material.Plastic
				v.Reflectance = 0
			elseif v:IsA("Decal") then
				_G.AntiLagBackup.decals[v] = {Transparency = v.Transparency, Texture = v.Texture}
				v.Transparency = 1
			elseif v:IsA("ParticleEmitter") or v:IsA("Trail") then
				v.Lifetime = NumberRange.new(0)
			end
		end

		for _, v in ipairs(Lighting:GetDescendants()) do
			if v:IsA("PostEffect") then
				_G.AntiLagBackup.post[v] = v.Enabled
				v.Enabled = false
			end
		end

		if _G.AntiLagConn then _G.AntiLagConn:Disconnect() end
		_G.AntiLagConn = workspace.DescendantAdded:Connect(function(child)
			task.spawn(function()
				if child:IsA("BasePart") then
					child.CastShadow = false
				end
			end)
		end)
	end,
},
{
	name = "UnAntiLag",
	desc = "UnAntiLag | off",
	args = false,
	run = function(value)
		_G.AntiLagActive = false
		if _G.AntiLagConn then _G.AntiLagConn:Disconnect(); _G.AntiLagConn = nil end

		local b = _G.AntiLagBackup
		if not b then return end

		local Terrain = workspace:FindFirstChildWhichIsA("Terrain")
		if Terrain and b.terrain then
			Terrain.WaterWaveSize = b.terrain.WaterWaveSize
			Terrain.WaterWaveSpeed = b.terrain.WaterWaveSpeed
			Terrain.WaterReflectance = b.terrain.WaterReflectance
			Terrain.WaterTransparency = b.terrain.WaterTransparency
		end

		local Lighting = game:GetService("Lighting")
		if b.light then
			Lighting.GlobalShadows = b.light.GlobalShadows
			Lighting.FogEnd = b.light.FogEnd
			Lighting.FogStart = b.light.FogStart
		end

		for part, data in pairs(b.parts or {}) do
			if part and part.Parent then
				part.CastShadow = data.CastShadow
				part.Material = data.Material
				part.Reflectance = data.Reflectance
			end
		end

		for decal, data in pairs(b.decals or {}) do
			if decal and decal.Parent then
				decal.Transparency = data.Transparency
				decal.Texture = data.Texture
			end
		end

		for pe, state in pairs(b.post or {}) do
			if pe and pe.Parent then
				pe.Enabled = state
			end
		end

		_G.AntiLagBackup = nil
	end,
},
{
	name = "SetFpsCap",
	desc = "SetFpsCap | number",
	args = true,
	run = function(value)
		if _G.FpsCapLoop then
			task.cancel(_G.FpsCapLoop)
			_G.FpsCapLoop = nil
		end

		local num = tonumber(value)
		if not num or num <= 0 then return end

		if setfpscap and type(setfpscap) == "function" then
			setfpscap(num)
		else
			_G.FpsCapLoop = task.spawn(function()
				local timer = os.clock()
				while true do
					if os.clock() >= timer + 1 / num then
						timer = os.clock()
						task.wait()
					end
				end
			end)
		end
	end,
},
}
	
