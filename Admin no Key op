			local oldOffset = h.CameraOffset
			local hideCF = oldCF * CFrame.new(0, -200000, 0)

			r.CFrame = hideCF
			h.CameraOffset = hideCF:ToObjectSpace(CFrame.new(oldCF.Position)).Position

			RunService.RenderStepped:Wait()

			r.CFrame = oldCF
			h.CameraOffset = oldOffset
		end)
