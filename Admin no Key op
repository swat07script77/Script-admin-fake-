			_G.FlingOriginalPlatform = hum.PlatformStand
		end

		if hum and hum.RigType == Enum.HumanoidRigType.R15 then
			local bws = hum:FindFirstChild("BodyWidthScale")
			local bds = hum:FindFirstChild("BodyDepthScale")
			if bws and bds then
				bws.Value = 4
				bds.Value = 4
				_G.FlingFatSet = true
			end
		end

		if char then
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") then part.CanCollide = false end
			end
		end

		local function disableCollision(c)
			if not c then return end
			for _, part in ipairs(c:GetDescendants()) do
				if part:IsA("BasePart") then part.CanCollide = false end
			end
		end

		local function getPredictedPosition(rootAlvo)
			local velocidade = rootAlvo.AssemblyLinearVelocity
			local speed = velocidade.Magnitude
			if speed > MIN_SPEED_PREDICT then
				local dir = velocidade.Unit
				local t = (speed - MIN_SPEED_PREDICT) / (SPEED_REFERENCE - MIN_SPEED_PREDICT)
				t = math.clamp(t, 0, 1)
				local factor = math.max(t, MIN_FACTOR)
				local distancia = math.min(speed * 0.625 * factor, MAX_DISTANCE)
				local horizDir = Vector3.new(dir.X, 0, dir.Z)
				local horizMag = horizDir.Magnitude
				local offsetX = dir.X * distancia
				local offsetZ = dir.Z * distancia
				local offsetY = dir.Y * distancia * VERTICAL_LIMIT
				if horizMag < 0.1 then
					offsetY = dir.Y * distancia * VERTICAL_LIMIT
				end
				local novaPos = rootAlvo.Position + Vector3.new(offsetX, offsetY, offsetZ)
				return Vector3.new(novaPos.X, novaPos.Y, novaPos.Z)
			end
			return rootAlvo.Position
		end

		if _G.FlingHeartbeat then _G.FlingHeartbeat:Disconnect() end
		_G.FlingHeartbeat = game:GetService("RunService").Heartbeat:Connect(function(dt)
			if not _G.FlingActive then
				if _G.FlingHeartbeat then _G.FlingHeartbeat:Disconnect(); _G.FlingHeartbeat = nil end
				return
			end

			local c = player.Character
			local root = c and c:FindFirstChild("HumanoidRootPart")
			if not root then return end

			pcall(function()
				sethiddenproperty(root, "NetworkIsSleeping", true)
			end)

			local valid = {}
			for _, p in ipairs(_G.FlingTargets) do
				if p and p.Parent and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
					table.insert(valid, p)
				end
			end

			if #valid == 0 then
				DeactivateFling(_G.FlingReturnCFrame, _G.FlingOriginalPlatform)
				return
			end

			_G.FlingTargets = valid

			local maxTime = (#valid > 1) and 0.3 or ONE_TARGET_TIME
			_G.FlingTimeOnTarget = _G.FlingTimeOnTarget + dt

			if _G.FlingTimeOnTarget >= maxTime then
				_G.FlingTimeOnTarget = 0
				if _G.FlingIndex >= #valid then
					DeactivateFling(_G.FlingReturnCFrame, _G.FlingOriginalPlatform)
					return
				end
				_G.FlingIndex = _G.FlingIndex + 1
			end

			local t = valid[_G.FlingIndex] or valid[1]
			local tr = t.Character.HumanoidRootPart

			pcall(function()
				sethiddenproperty(tr, "CanCollide", false)
			end)
			tr.CanCollide = false

			disableCollision(c)

			local TargetPos = getPredictedPosition(tr)
			_G.FlingAngle = _G.FlingAngle + 100

			workspace.FallenPartsDestroyHeight = 0 / 0
			local sequence = {
				Vector3.new(0, -1.5, 0),
				Vector3.new(0, -1.5, 0),
				Vector3.new(2.5, -1.5, -2.5),
				Vector3.new(-2.5, -1.5, 2.5)
			}
			local currentOffset = sequence[math.floor(tick() * 15) % #sequence + 1]

			root.CFrame = CFrame.new(TargetPos + currentOffset) * CFrame.Angles(math.rad(_G.FlingAngle), 0, 0)
			root.CFrame = root.CFrame * CFrame.new(
				math.random(-100, 100) / 200,
				math.random(-100, 100) / 200,
				math.random(-100, 100) / 200
			)

			root.Velocity = Vector3.new(0, -FORCE_VALUE, 0)
			root.RotVelocity = Vector3.new(FORCE_VALUE, FORCE_VALUE, FORCE_VALUE)
		end)
	end,
