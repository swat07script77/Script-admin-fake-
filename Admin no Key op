{
	name = "Fling",
	desc = "Fling | name play | all",
	args = true,
	run = function(value)
		local function DeactivateFling(restoreCFrame, originalPlatform)
			_G.FlingActive = false
			if _G.FlingFatSet then
				local char = player.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if hum and hum.RigType == Enum.HumanoidRigType.R15 then
					local bws = hum:FindFirstChild("BodyWidthScale")
					local bds = hum:FindFirstChild("BodyDepthScale")
					if bws then bws.Value = 1 end
					if bds then bds.Value = 1 end
				end
				_G.FlingFatSet = false
			end
			_G.FlingTargets = {}
			_G.FlingAngle = 0
			_G.FlingIndex = 1
			_G.FlingTimeOnTarget = 0

			-- Restaura colisão das partes do personagem
			local char = player.Character
			if char then
				for _, part in ipairs(char:GetDescendants()) do
					if part:IsA("BasePart") then
						part.CanCollide = true
					end
				end
			end

			if restoreCFrame then
				local c = player.Character
				if c then
					local root = c:FindFirstChild("HumanoidRootPart")
					local hum = c:FindFirstChildOfClass("Humanoid")
					if hum then
						hum.PlatformStand = originalPlatform or false
						hum:ChangeState(Enum.HumanoidStateType.GettingUp)
					end
					if root then
						root.Velocity = Vector3.zero
						root.RotVelocity = Vector3.zero
						-- Desce um pouco pra não atravessar o chão
						root.CFrame = restoreCFrame + Vector3.new(0, 2, 0)
					end
				end
			end
		end

		if _G.FlingActive then
			DeactivateFling(_G.FlingReturnCFrame, _G.FlingOriginalPlatform)
			return
		end

		local FORCE_VALUE = 50000
		local MAX_DISTANCE = math.huge
		local MIN_SPEED_PREDICT = 6
		local SPEED_REFERENCE = 16
		local MIN_FACTOR = 0.25
		local VERTICAL_LIMIT = 0.3
		local ONE_TARGET_TIME = 2

		local arg = tostring(value)
		if arg == "" then return end

		local sethiddenproperty = sethiddenproperty or function() return false end
		local targets = {}

		if string.lower(arg) == "all" then
			for _, p in ipairs(game.Players:GetPlayers()) do
				if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
					table.insert(targets, p)
				end
			end
			if #targets == 0 then return end
		else
			local found = nil
			local q = string.lower(arg)
			for _, p in ipairs(game.Players:GetPlayers()) do
				if p ~= player then
					if string.lower(p.Name) == q or string.lower(p.DisplayName) == q
						or string.find(string.lower(p.Name), q, 1, true)
						or string.find(string.lower(p.DisplayName), q, 1, true) then
						found = p
						break
					end
				end
			end
			if not found then return end
			if not (found.Character and found.Character:FindFirstChild("HumanoidRootPart")) then return end
			table.insert(targets, found)
		end

		_G.FlingActive = true
		_G.FlingTargets = targets
		_G.FlingIndex = 1
		_G.FlingTimeOnTarget = 0
		_G.FlingAngle = 0
		_G.FlingFatSet = false

		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp then
			_G.FlingReturnCFrame = hrp.CFrame
		end

