{
	name = "Sound",
	desc = "Sound | swim loop",
	args = false,
	run = function(value)
		-- ===== SOUND =====
		_G.SoundActive = true
		local char = player.Character
		if not char then return end
		local hum = char:FindFirstChildOfClass("Humanoid")
		local root = char:FindFirstChild("HumanoidRootPart")
		if not hum or not root then return end

		if _G.SoundConn then _G.SoundConn:Disconnect(); _G.SoundConn = nil end
		if _G.SoundJumpConn then _G.SoundJumpConn:Disconnect(); _G.SoundJumpConn = nil end
		if _G.SoundCharConn then _G.SoundCharConn:Disconnect(); _G.SoundCharConn = nil end

		hum:SetStateEnabled(Enum.HumanoidStateType.Swimming, true)
		hum:ChangeState(Enum.HumanoidStateType.Swimming)

		_G.SoundLastToggle = tick()

		_G.SoundConn = RunService.RenderStepped:Connect(function()
			if not _G.SoundActive then return end
			local c = player.Character
			local h = c and c:FindFirstChildOfClass("Humanoid")
			local r = c and c:FindFirstChild("HumanoidRootPart")
			if not h or not r then return end

			if tick() - _G.SoundLastToggle >= 0 then
				_G.SoundLastToggle = tick()
				if h:GetState() == Enum.HumanoidStateType.Swimming then
					h:ChangeState(Enum.HumanoidStateType.Running)
				elseif h:GetState() ~= Enum.HumanoidStateType.Jumping
					and h:GetState() ~= Enum.HumanoidStateType.Freefall then
					h:ChangeState(Enum.HumanoidStateType.Swimming)
				end
			end
		end)

		_G.SoundJumpConn = UserInputService.JumpRequest:Connect(function()
			if not _G.SoundActive then return end
			local c = player.Character
			local h = c and c:FindFirstChildOfClass("Humanoid")
			local r = c and c:FindFirstChild("HumanoidRootPart")
			if h and r then
				h:ChangeState(Enum.HumanoidStateType.Jumping)
				r.AssemblyLinearVelocity = Vector3.new(r.AssemblyLinearVelocity.X, h.JumpPower > 0 and h.JumpPower or 50, r.AssemblyLinearVelocity.Z)
			end
		end)

		-- ===== WALKFLING junto =====
		_G.SoundWalkFlingActive = true
		_G.SoundWalkFlingThread = task.spawn(function()
			repeat
				RunService.Heartbeat:Wait()
				if not _G.SoundWalkFlingActive then break end
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				if not root then
					-- não reseta o flag, só espera o próximo frame
					continue
				end
				local vel = root.Velocity
				root.Velocity = Vector3.new(0, 10000, 0)
				RunService.RenderStepped:Wait()
				if _G.SoundWalkFlingActive and character and character.Parent and root and root.Parent then
					root.Velocity = vel
				end
				RunService.Stepped:Wait()
				if _G.SoundWalkFlingActive and character and character.Parent and root and root.Parent then
					root.Velocity = Vector3.new(vel.X, vel.Y + 0.1, vel.Z)
				end
			until _G.SoundWalkFlingActive == false
		end)

		-- Detector de respawn: se morrer, desativa tudo automaticamente
		_G.SoundCharConn = player.CharacterAdded:Connect(function()
			_G.SoundActive = false
			_G.SoundWalkFlingActive = false
			if _G.SoundConn then _G.SoundConn:Disconnect(); _G.SoundConn = nil end
			if _G.SoundJumpConn then _G.SoundJumpConn:Disconnect(); _G.SoundJumpConn = nil end
			if _G.SoundWalkFlingThread then task.cancel(_G.SoundWalkFlingThread); _G.SoundWalkFlingThread = nil end
			if _G.SoundCharConn then _G.SoundCharConn:Disconnect(); _G.SoundCharConn = nil end
		end)
	end,
},
