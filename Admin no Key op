		local function enableGodMode()
			local char = player.Character
			if not char then return false end
			local hum = char:FindFirstChildOfClass("Humanoid")
			if not hum then return false end

			hum.MaxHealth = math.huge
			hum.Health = math.huge

			local healthChangedConn = hum.HealthChanged:Connect(function(newHealth)
				if not _G.GodModeActive then return end
				if newHealth < math.huge then
					hum.Health = math.huge
				end
			end)
			table.insert(_G.GodModeConnections, healthChangedConn)

			local ffConn = char.ChildAdded:Connect(function(child)
				if not _G.GodModeActive then return end
				if child:IsA("ForceField") then
					child:Destroy()
				end
			end)
			table.insert(_G.GodModeConnections, ffConn)

			local function removeDamageOverlay()
				local playerGui = player:FindFirstChild("PlayerGui")
				if not playerGui then return end
				local overlayNames = {"HurtOverlay", "DamageOverlay", "RedEffect", "BloodOverlay", "DamageHud"}
				for _, name in ipairs(overlayNames) do
					local overlay = playerGui:FindFirstChild(name)
					if overlay then overlay:Destroy() end
				end
			end
			removeDamageOverlay()
			local overlayRemoverConn = RunService.Heartbeat:Connect(function()
				if not _G.GodModeActive then return end
				removeDamageOverlay()
			end)
			table.insert(_G.GodModeConnections, overlayRemoverConn)

			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanTouch = false
				end
			end
			local touchDisablerConn = char.DescendantAdded:Connect(function(desc)
				if not _G.GodModeActive then return end
				if desc:IsA("BasePart") then
					desc.CanTouch = false
				end
			end)
			table.insert(_G.GodModeConnections, touchDisablerConn)

			return true
		end

		enableGodMode()

		if _G.GodModeCharConn then _G.GodModeCharConn:Disconnect() end
		_G.GodModeCharConn = player.CharacterAdded:Connect(function()
			if _G.GodModeActive then
				task.wait(0.1)
				enableGodMode()
			end
		end)
	end,
