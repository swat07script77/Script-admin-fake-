	name = "NoclipCam",
	desc = "NoclipCam | toggle",
	args = false,
	run = function(value)
		if _G.NoclipCamActive then return end

		local sc = (debug and debug.setconstant) or setconstant
		local gc = (debug and debug.getconstants) or getconstants
		if not sc or not getgc or not gc then
			warn("NoclipCam: exploit não suporta setconstant/getconstants/getgc")
			return
		end

		local pop = player.PlayerScripts.PlayerModule.CameraModule.ZoomController.Popper

		if _G.NoclipCamBackup then
			-- restaura se já tinha rodado
			for func, changes in pairs(_G.NoclipCamBackup) do
				for i, old in pairs(changes) do
					pcall(function() sc(func, i, old) end)
				end
			end
			_G.NoclipCamBackup = nil
		end

		_G.NoclipCamActive = true
		_G.NoclipCamBackup = _G.NoclipCamBackup or {}

		for _, v in pairs(getgc()) do
			if type(v) == "function" then
				local ok, env = pcall(getfenv, v)
				if ok and env and env.script == pop then
					local constants = gc(v)
					if constants then
						for i, v1 in pairs(constants) do
							if tonumber(v1) == 0.25 then
								_G.NoclipCamBackup[v] = _G.NoclipCamBackup[v] or {}
								_G.NoclipCamBackup[v][i] = v1
								sc(v, i, 0)
							elseif tonumber(v1) == 0 then
								_G.NoclipCamBackup[v] = _G.NoclipCamBackup[v] or {}
								_G.NoclipCamBackup[v][i] = v1
								sc(v, i, 0.25)
							end
						end
					end
				end
			end
		end
	end,
