			if not root or not hum then return end

			local vel = root.Velocity
			if hum.FloorMaterial == Enum.Material.Air and hum:GetState() ~= Enum.HumanoidStateType.Jumping then
				root.Velocity = Vector3.new(vel.X, 0, vel.Z)
